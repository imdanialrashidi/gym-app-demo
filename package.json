{
  "name": "amirs-gym",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Amir's Gym — a cinematic, bilingual (Persian/English) bodybuilding training demo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && vite build --base=/app/ --outDir=dist-app && node scripts/build-site.mjs",
    "preview": "vite preview",
    "preview:site": "vite preview --outDir dist --port 4175",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
